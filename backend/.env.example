# Эти переменные читаются backend-процессом из process.env.
PORT=4000
CORS_ORIGIN=http://localhost:5173
DB_PATH=./data/logistics.db
# If both Turso variables are set, the backend uses the cloud database instead of DB_PATH.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BUSINESS_TIMEZONE=Asia/Bishkek
APP_VERSION=2.0.0
TRUST_PROXY=false
JSON_BODY_LIMIT=256kb
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
